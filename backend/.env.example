# LearnSync AI Backend Production Environment Configuration Template
# Copy to .env and configure real credentials for deployment

# Environment & Core Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Google Gemini API Settings (Backend Only — Never expose to Frontend)
GEMINI_API_KEY=your_real_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER_MODE=auto

# Security & CORS
CORS_ORIGINS=https://app.learnsync.ai,https://teacher.learnsync.ai,http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_64_character_string

# Database Connection (MongoDB Production Connection String)
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/learnsync?retryWrites=true&w=majority

# Upload limits
MAX_UPLOAD_SIZE_MB=5
